{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rrpauls/esra/main/schemas/conformance-matrix.schema.json",
  "title": "ESRA Cross-Implementation Conformance Matrix",
  "type": "object",
  "required": ["matrix_version", "protocol_version", "implementations"],
  "properties": {
    "matrix_version": {"const": "1.0.0"},
    "protocol_version": {"const": "1.2"},
    "implementations": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/implementation"}
    }
  },
  "$defs": {
    "implementation": {
      "type": "object",
      "required": ["implementation", "manifest", "exporter"],
      "properties": {
        "implementation": {"type": "string", "minLength": 1},
        "manifest": {"type": "string", "format": "uri"},
        "exporter": {
          "type": "object",
          "required": ["status", "command", "record_formats", "evidence"],
          "properties": {
            "status": {"enum": ["implemented", "verified", "simulated", "planned"]},
            "command": {"type": "string", "minLength": 1},
            "record_formats": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]*@[0-9]+\\.[0-9]+\\.[0-9]+$"}
            },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": {"type": "string", "minLength": 1}
            },
            "notes": {"type": "string"}
          },
          "additionalProperties": false
        },
        "autonomy": {
          "type": "object",
          "required": ["profile", "status", "evidence", "hosts"],
          "properties": {
            "profile": {"const": "Autonomous Agent Profile 1.0"},
            "status": {"enum": ["implemented", "prerelease", "stable"]},
            "evidence": {"type": "string", "format": "uri"},
            "hosts": {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": {"type": "string", "minLength": 1}
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
