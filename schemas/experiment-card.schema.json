{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/rrpauls/esra/main/schemas/experiment-card.schema.json",
  "title": "ESRA Experiment Card",
  "type": "object",
  "required": [
    "schema_version",
    "protocol_version",
    "id",
    "hypothesis",
    "mode",
    "guardrails",
    "stopping_rule",
    "alignment"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_version": {"const": "1.2"},
    "id": {"type": "string", "minLength": 1},
    "hypothesis": {"type": "string", "minLength": 1},
    "mode": {"enum": ["canary", "staged", "ab", "stress"]},
    "baseline": {"type": ["string", "array", "object", "null"]},
    "candidate": {"type": ["string", "array", "object"]},
    "guardrails": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 1
    },
    "stopping_rule": {"type": "string", "minLength": 1},
    "alignment": {"$ref": "https://raw.githubusercontent.com/rrpauls/esra/main/schemas/alignment-assessment.schema.json"},
    "status": {"enum": ["draft", "ready", "running", "closed", "blocked"]}
  },
  "additionalProperties": false
}
